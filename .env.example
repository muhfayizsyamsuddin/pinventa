# Pinventa provider configuration (server-side only; never prefix with NEXT_PUBLIC_
# except the map tile settings below, which are public by nature).
# Copy to .env.local to override defaults. All values are optional.

# Identifies this app to OSM services (REQUIRED by the Nominatim usage policy:
# https://operations.osmfoundation.org/policies/nominatim/). Include a real contact.
APP_USER_AGENT="Pinventa/0.1 (MAXY Academy hackathon prototype; contact: you@example.com)"

# Forward geocoding provider (Nominatim-compatible /search endpoint). Max 1 req/sec is enforced in code.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_MS=8000
GEOCODER_CACHE_TTL_MS=86400000

# Overpass endpoint. Supported options include:
# - Default: https://overpass-api.de/api/interpreter (public instance)
# - Overpass.ch: https://api.overpass.ch/v1/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional API key (e.g. for Overpass.ch: sent as X-API-Key header). Leave empty for public instances.
OVERPASS_API_KEY=
OVERPASS_TIMEOUT_MS=30000
OVERPASS_ELEMENT_LIMIT=200
OVERPASS_CACHE_TTL_MS=300000
DISCOVER_MAX_RESULTS=50

# Map tiles (browser-visible). The default is the standard OSM tile server, which is
# for light use only: https://operations.osmfoundation.org/policies/tiles/
# For production, use a tile provider/own server and keep attribution correct.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright' target='_blank' rel='noopener noreferrer'>OpenStreetMap</a> contributors"

# n8n & Google Sheets Database Integration
# N8N_WEBHOOK_URL is triggered during lead scoring
N8N_WEBHOOK_URL=
# (Optional) Direct Google Sheet ID or public CSV export URL for syncing outreach drafts
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv

